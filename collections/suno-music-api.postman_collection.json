          "request": {
            "name": "Generate music",
            "description": {
              "content": "Creates a music generation task. Returns a taskId; results are delivered via the callBackUrl when ready (stream URLs in ~30-40s, downloadable URLs in 2-3 minutes). Exactly two songs are returned per successful task.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "generate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
