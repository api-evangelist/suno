  "info": {
    "_postman_id": "bdf26201-1610-48f2-83ba-cb083a685525",
    "name": "Suno API (sunoapi.org) Lyrics Music API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Third-party Suno API gateway (sunoapi.org) for AI music, lyrics, and audio generation. Suno itself does not publish a sanctioned developer API as of May 2026; this OpenAPI describes the public-facing endpoints documented at https://docs.sunoapi.org. Endpoints are asynchronous and rely on a callBackUrl for completion notifications, with task status retrievable via record-info endpoints.\n\nContact Support:\n Name: sunoapi.org docs",
      "type": "text/plain"
    }
