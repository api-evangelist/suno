            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customMode\": \"<boolean>\",\n  \"instrumental\": \"<boolean>\",\n  \"callBackUrl\": \"<uri>\",\n  \"model\": \"<string>\",\n  \"prompt\": \"<string>\",\n  \"style\": \"<string>\",\n  \"title\": \"<string>\",\n  \"personaId\": \"<string>\",\n  \"personaModel\": \"<string>\",\n  \"negativeTags\": \"<string>\",\n  \"vocalGender\": \"<string>\",\n  \"styleWeight\": \"<number>\",\n  \"weirdnessConstraint\": \"<number>\",\n  \"audioWeight\": \"<number>\"\n}",
